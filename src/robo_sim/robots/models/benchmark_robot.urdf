  <link name="left_wheel">
    <inertial><origin xyz="0 0 0"/><mass value="0.18"/><inertia ixx="0.00025" ixy="0" ixz="0" iyy="0.00045" iyz="0" izz="0.00025"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.05" length="0.035"/></geometry><material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual>
