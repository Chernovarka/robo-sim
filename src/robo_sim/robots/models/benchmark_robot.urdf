  </link>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.12 -0.05"/><axis xyz="0 1 0"/></joint>
  <link name="caster">
    <inertial><origin xyz="0 0 0"/><mass value="0.04"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
