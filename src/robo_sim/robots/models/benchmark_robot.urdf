<?xml version="1.0"?>
<robot name="benchmark_robot">
  <link name="base_link">
    <inertial><origin xyz="0 0 0"/><mass value="1.6"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.014"/></inertial>
    <visual><geometry><box size="0.30 0.24 0.12"/></geometry><material name="blue"><color rgba="0.20 0.48 0.82 1"/></material></visual>
